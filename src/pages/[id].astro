---
import SuggestionButton from '../components/SuggestionButton.tsx'
import { getBookmark, updateBookmark } from '../lib/bookmarks'
import { parseClicks } from '../lib/clicks'
import { parseTags } from '../lib/tags'
import Layout from '../layouts/Layout.astro'

const id = Astro.params.id
if (!id) return Astro.redirect('/')

const bookmark = await getBookmark(id)
if (!bookmark) {
	return Astro.redirect('/')
}

if (Astro.request.method === 'POST') {
	const formData = await Astro.request.formData()
	const url = formData.get('url')?.toString().trim() || ''
	const title = formData.get('title')?.toString().trim() || ''
	const notes = formData.get('notes')?.toString().trim() || ''
	const category = formData.get('category')?.toString().trim() || ''
	const tags = parseTags(formData.get('tags')?.toString() ?? '')
	const clicks = parseClicks(formData.get('clicks'), bookmark.clicks ?? 0)

	await updateBookmark(id, { url, title, notes, category, tags, clicks })

	return Astro.redirect('/')
}

const tagsString = bookmark.tags ? bookmark.tags.join(', ') : ''
---

<Layout title="Edit Bookmark">
	<header>
		<h1>Edit Bookmark</h1>
		<nav>
			<a href="/" class="button">
				Back to List
			</a>
		</nav>
	</header>

	<main>
		<form method="POST" action={`/${id}`}>
			<div class="form-group">
				<label for="url">URL *</label>
				<input type="url" id="url" name="url" value={bookmark.url} required />
			</div>

			<div class="form-group">
				<label for="title">Title</label>
				<input type="text" id="title" name="title" value={bookmark.title} />
			</div>

			<div class="form-group">
				<label for="category">Category</label>
				<input
					type="text"
					id="category"
					name="category"
					value={bookmark.category ?? ''}
					autocomplete="bookmarker-category"
				/>
			</div>

			<div class="form-group">
				<label for="notes">Notes</label>
				<textarea id="notes" name="notes" rows="6">{bookmark.notes}</textarea>
			</div>

			<div class="form-group">
				<label for="tags">Tags (comma separated)</label>
				<input type="text" id="tags" name="tags" value={tagsString} placeholder="..., ..., ..." />
			</div>

			<div class="form-group">
				<label for="clicks">Clicks</label>
				<input type="number" id="clicks" name="clicks" min="0" step="1" value={bookmark.clicks ?? 0} />
			</div>

			<div class="form-actions">
				<button type="submit">Update Bookmark</button>
				<SuggestionButton client:load />
			</div>
		</form>
	</main>
</Layout>

<style>
	header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 2rem;
	}

	.form-group {
		margin-bottom: 1rem;
	}

	.form-actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: 0.5rem;
	}

	form {
		max-width: 32rem;
	}
</style>
