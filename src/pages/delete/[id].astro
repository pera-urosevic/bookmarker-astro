---
import { deleteBookmark, getBookmark } from '../../lib/bookmarks'
import Layout from '../../layouts/Layout.astro'

const id = Astro.params.id
if (!id) return Astro.redirect('/')

const bookmark = await getBookmark(id)
if (!bookmark) {
	return Astro.redirect('/')
}

if (Astro.request.method === 'POST') {
	await deleteBookmark(id)
	return Astro.redirect('/')
}
---

<Layout title="Delete Bookmark?">
	<header>
		<h1>Delete Bookmark</h1>
		<nav>
			<a href="/" class="button">
				Back to List
			</a>
		</nav>
	</header>

	<main>
		<div class="warning-block">
			<p>
				<strong>Are you sure you want to delete this bookmark?</strong>
			</p>
		</div>

		<div class="bookmark-preview">
			<h2>{bookmark.title || bookmark.url}</h2>
			<p>
				<a href={bookmark.url} target="_blank" rel="noopener noreferrer">
					{bookmark.url}
				</a>
			</p>
			{bookmark.notes && <p class="bookmark-notes">{bookmark.notes}</p>}
			{bookmark.tags && bookmark.tags.length > 0 && (
				<div class="bookmark-tags">
					{bookmark.tags.map(tag => (
						<span class="tag">{tag}</span>
					))}
				</div>
			)}
		</div>

		<form method="POST" action={`/delete/${id}`}>
			<div class="form-actions">
				<button type="submit" style="background-color: var(--color-error);">
					Delete
				</button>
				<a href="/" class="button">
					Cancel
				</a>
			</div>
		</form>
	</main>
</Layout>

<style>
	header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 2rem;
	}

	.bookmark-preview {
		background-color: var(--color-surface);
		padding: 1rem;
		margin: 1rem 0;
		border-radius: 6px;
	}

	.bookmark-notes {
		margin-top: 0.5rem;
		color: var(--color-text-muted);
	}

	.bookmark-tags {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
		margin-top: 0.5rem;
	}

	.tag {
		padding: 0.25em 0.5em;
		background-color: var(--color-background);
		border-radius: 4px;
		font-size: 0.875rem;
	}

	.form-actions {
		display: flex;
		gap: 0.5rem;
	}
</style>
